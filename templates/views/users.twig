{% extends 'layout.twig' %}

{% block body %}
  <h1>{{ title|e }}</h1>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
      </tr>
    </thead>
    <tbody>
      {% for user in users %}
        <tr>
          <td>{{ user.name|e }}</td>
          <td>{{ user.email|e }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endblock %}
