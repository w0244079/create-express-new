<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
  </head>
  <body>
    <header>
      <nav>
        <a class="brand" href="/">Express</a>
        <a href="/">Home</a>
        <a href="/users">Users</a>
      </nav>
    </header>
    <main>
      <h1><%= title %></h1>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((user) => { %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </main>
  </body>
</html>
