<% if (esm) { -%>
import express from 'express';
<% } else { -%>
const express = require('express');
<% } -%>

const router = express.Router();

/* GET users listing. */
router.get('/', (req, res) => {
<% if (api) { -%>
  res.json([]);
<% } else { -%>
  res.send('respond with a resource');
<% } -%>
});

<% if (form) { -%>
/* GET the new user form. */
router.get('/new', (req, res) => {
  res.render('new-user', { title: 'New user', added: req.query.added });
});

/* POST the new user form, after the app checks its CSRF token. */
router.post('/new', (req, res) => {
  const name = String(req.body?.name ?? '').trim();

  if (!name) {
    res.status(400).render('new-user', { title: 'New user', error: 'Enter a name' });
    return;
  }

  // save the user here, then redirect, so refreshing the page does not post again
  res.redirect(303, `/users/new?added=${encodeURIComponent(name)}`);
});

<% } -%>
<% if (esm) { -%>
export default router;
<% } else { -%>
module.exports = router;
<% } -%>
