<% if (esm) { -%>
import express from 'express';

import usersRouter from './users.<%- ext %>';
<% } else { -%>
const express = require('express');

const usersRouter = require('./users.<%- ext %>');
<% } -%>

const router = express.Router();

// JSON routes, mounted at /api: errors under /api, such as the 404 of a
// route that is not here, respond with JSON too (see the app's error handlers)

/* GET the API's welcome message. */
router.get('/', (req, res) => {
  res.json({ message: 'Welcome to Express' });
});

// the routers of the API's resources, one file each
router.use('/users', usersRouter);

<% if (esm) { -%>
export default router;
<% } else { -%>
module.exports = router;
<% } -%>
