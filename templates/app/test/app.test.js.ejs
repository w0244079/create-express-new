<% if (esm) { -%>
import assert from 'node:assert';
import { once } from 'node:events';
<% if (uploads) { -%>
import fs from 'node:fs';
<% } -%>
<% if (ts) { -%>
import type { Server } from 'node:http';
import type { AddressInfo } from 'node:net';
<% } -%>
import { after, before, describe, it } from 'node:test';
<% if (uploads) { -%>
import path from 'node:path';
<% } -%>
import app from '../app.<%- ext %>';
<% } else { -%>
const assert = require('node:assert');
const { once } = require('node:events');
<% if (uploads) { -%>
const fs = require('node:fs');
const path = require('node:path');
<% } -%>
const { after, before, describe, it } = require('node:test');
const app = require('../app.js');
<% } -%>

// skip request logs while testing (see app.<%- ext %>)
process.env.NODE_ENV = 'test';

describe('app', () => {
<% if (ts) { -%>
  let server: Server;
  let baseUrl: string;
<% } else { -%>
  let server;
  let baseUrl;
<% } -%>

  before(async () => {
    // listen on a random free port
    server = app.listen(0);
    await once(server, 'listening');
<% if (ts) { -%>
    baseUrl = `http://localhost:${(server.address() as AddressInfo).port}`;
<% } else { -%>
    baseUrl = `http://localhost:${server.address().port}`;
<% } -%>
  });

  after(() => {
    server.close();
  });
<% if (csrf) { -%>

  // a session cookie and its CSRF token, from a page with a form
<% if (ts) { -%>
  async function csrfSession(url: string) {
<% } else { -%>
  async function csrfSession(url) {
<% } -%>
    const res = await fetch(url);
    const cookie = res.headers.getSetCookie().map((header) => header.split(';')[0]).join('; ');
    const token = /<meta name="csrf-token" content="([^"]+)">/.exec(await res.text())?.[1] ?? '';
    return { cookie, token };
  }
<% } -%>

  it('responds to GET /health', async () => {
    const res = await fetch(`${baseUrl}/health`);
    assert.strictEqual(res.status, 200);
    assert.deepStrictEqual(await res.json(), { status: 'ok' });
  });

<% if (rateLimit) { -%>
  it('sends rate limit headers', async () => {
    const res = await fetch(`${baseUrl}/`);
    assert.ok(res.headers.has('ratelimit-policy'));
  });

<% } -%>
<% if (csrf) { -%>
  it('rejects posts without a CSRF token', async () => {
    const res = await fetch(`${baseUrl}/users/new`, { method: 'POST', body: new URLSearchParams({ name: 'Ada' }) });
    assert.strictEqual(res.status, 403);
  });

  it('adds a user with the form and its CSRF token', async () => {
    const { cookie, token } = await csrfSession(`${baseUrl}/users/new`);
    const res = await fetch(`${baseUrl}/users/new`, {
      method: 'POST',
      headers: { cookie },
      body: new URLSearchParams({ _csrf: token, name: 'Ada' }),
      redirect: 'manual'
    });
    assert.strictEqual(res.status, 303);
    assert.strictEqual(res.headers.get('location'), '/users/new?added=Ada');
  });

  it('asks again for a user without a name', async () => {
    const { cookie, token } = await csrfSession(`${baseUrl}/users/new`);
    const res = await fetch(`${baseUrl}/users/new`, {
      method: 'POST',
      headers: { cookie },
      body: new URLSearchParams({ _csrf: token, name: ' ' })
    });
    assert.strictEqual(res.status, 400);
    assert.match(await res.text(), /Enter a name/);
  });

<% } -%>
<% if (uploads) { -%>
  it('uploads a file', async () => {
    const uploads = path.join(<%- esm ? 'import.meta.dirname' : '__dirname' %>, '..', 'uploads');
    const existing = new Set(fs.readdirSync(uploads));
<% if (csrf) { -%>
    const { cookie, token } = await csrfSession(`${baseUrl}/uploads`);
<% } -%>
    const body = new FormData();
<% if (csrf) { -%>
    // the token comes before the file, so it is checked before saving
    body.append('_csrf', token);
<% } -%>
    body.append('file', new Blob(['hello'], { type: 'text/plain' }), 'hello.txt');

<% if (csrf) { -%>
    const res = await fetch(`${baseUrl}/uploads`, { method: 'POST', headers: { cookie }, body, redirect: 'manual' });
<% } else { -%>
    const res = await fetch(`${baseUrl}/uploads`, { method: 'POST', body, redirect: 'manual' });
<% } -%>
<% if (view) { -%>
    assert.strictEqual(res.status, 303);
    assert.strictEqual(res.headers.get('location'), '/uploads?uploaded=hello.txt');
<% } else { -%>
    assert.strictEqual(res.status, 201);
    assert.strictEqual((await res.json()).name, 'hello.txt');
<% } -%>

    // remove the uploaded file
    const added = fs.readdirSync(uploads).filter((file) => !existing.has(file));
    assert.strictEqual(added.length, 1);
    for (const file of added) fs.rmSync(path.join(uploads, file));
  });

  it('rejects unsupported file types', async () => {
<% if (csrf) { -%>
    const { cookie, token } = await csrfSession(`${baseUrl}/uploads`);
<% } -%>
    const body = new FormData();
<% if (csrf) { -%>
    body.append('_csrf', token);
<% } -%>
    body.append('file', new Blob(['<html>'], { type: 'text/html' }), 'page.html');

<% if (csrf) { -%>
    const res = await fetch(`${baseUrl}/uploads`, { method: 'POST', headers: { cookie }, body });
<% } else { -%>
    const res = await fetch(`${baseUrl}/uploads`, { method: 'POST', body });
<% } -%>
    assert.strictEqual(res.status, 415);
  });

<% } -%><% if (api) { -%>
  it('responds to GET /', async () => {
    const res = await fetch(`${baseUrl}/`);
    assert.strictEqual(res.status, 200);
    assert.deepStrictEqual(await res.json(), { message: 'Welcome to Express' });
  });

  it('responds to GET /users', async () => {
    const res = await fetch(`${baseUrl}/users`);
    assert.strictEqual(res.status, 200);
    assert.deepStrictEqual(await res.json(), []);
  });

  it('responds with a JSON 404 for unknown routes', async () => {
    const res = await fetch(`${baseUrl}/does-not-exist`);
    assert.strictEqual(res.status, 404);
    assert.match(res.headers.get('content-type') ?? '', /application\/json/);
    assert.strictEqual((await res.json()).error, 'Not Found');
  });
});
<% } else { -%>
  it('responds to GET /', async () => {
    const res = await fetch(`${baseUrl}/`);
    assert.strictEqual(res.status, 200);
  });

  it('responds to GET /users', async () => {
    const res = await fetch(`${baseUrl}/users`);
    assert.strictEqual(res.status, 200);
    assert.strictEqual(await res.text(), 'respond with a resource');
  });

  it('responds with 404 for unknown routes', async () => {
    const res = await fetch(`${baseUrl}/does-not-exist`);
    assert.strictEqual(res.status, 404);
  });
});
<% } -%>
