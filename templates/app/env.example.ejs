# Environment variables for local development.
#
# Copy this file to .env, which `npm start` and `npm run dev` load automatically.
# Variables already set in the environment take precedence over .env.
# Do not commit .env.

PORT=3000

# Set to production when you deploy
# NODE_ENV=production
<% if (cors) { -%>

# Comma-separated origins allowed to call the app from a browser
# (defaults to any origin)
# CORS_ORIGIN=https://example.com,https://admin.example.com
<% } -%>
<% if (trustProxy) { -%>

# Behind a load balancer or other proxy, the number of proxies (or their
# addresses), so the app sees each client's IP address and protocol
# TRUST_PROXY=1
<% } -%>
<% if (rateLimit) { -%>

# Requests each client may make in each window of milliseconds
# (defaults to 100 every 15 minutes)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000
<% } -%>
<% if (session) { -%>

# Long random secret that signs the session cookie, required in production,
# such as the output of: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# SESSION_SECRET=
<% } -%>
