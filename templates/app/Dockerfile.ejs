# syntax=docker/dockerfile:1

<% if (pm === 'pnpm') { -%>
# Production image. Build it after `pnpm install`, which creates the
# pnpm-lock.yaml that the image installs from:
<% } else { -%>
# Production image. Build it after `npm install`, which creates the
# package-lock.json that `npm ci` needs:
<% } -%>
#
#   docker build -t <%- name %> .
#   docker run -p 3000:3000 <%- name %>

# Dependencies are installed in their own stage, which keeps the package
# manager out of the final image.

# the latest Node.js 22 release, matching the minimum version in package.json
FROM node:22-slim AS dependencies

WORKDIR /app

<% if (pm === 'pnpm') { -%>
# the package manager this app requires in package.json; it switches to the
# pnpm version recorded in pnpm-lock.yaml
<% } else { -%>
# the package manager this app requires in package.json
<% } -%>
RUN npm install -g <%- pm %>@<%- pmVersion %>

# install production dependencies first, so they are cached between builds
<% if (pm === 'pnpm') { -%>
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod
<% } else { -%>
COPY package*.json .npmrc ./
RUN npm ci --omit=dev
<% } -%>

FROM node:22-slim

ENV NODE_ENV=production
WORKDIR /app

# the dependencies installed above
COPY --from=dependencies /app/node_modules ./node_modules

# copy the app owned by the unprivileged node user, which runs it, so it can
# read the files whatever their permissions on the build machine
COPY --chown=node:node . .
<% if (uploads) { -%>

# a folder for uploaded files that the node user can write to; files saved
# in a container are lost when it is replaced, so mount a volume here
RUN mkdir -p uploads && chown node:node uploads
<% } -%>
USER node

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s \
  CMD node -e "fetch('http://localhost:' + (process.env.PORT || 3000) + '/health').then((res) => process.exit(res.ok ? 0 : 1), () => process.exit(1))"

# run node directly, so it receives SIGTERM and shuts down gracefully
CMD ["node", "<%- www %>"]
