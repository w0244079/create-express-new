<% if (esm) { -%>
import express from 'express';
<% } else { -%>
const express = require('express');
<% } -%>

const router = express.Router();

/* GET home page. */
router.get('/', (req, res) => {
  res.render('index', { title: 'Express' });
});

<% if (esm) { -%>
export default router;
<% } else { -%>
module.exports = router;
<% } -%>
