// The development environment: the Node.js image with the version the publish
// workflow uses, Docker to build the image generated by --docker, the GitHub
// CLI, and the pnpm and npm versions that generated apps install, as in the ci
// workflow, so that no test is skipped.
{
  "name": "create-express-new",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // npm 12 is for the tests that install an npm app; this repository itself
  // requires pnpm
  "postCreateCommand": "npm install -g \"pnpm@$(node -p \"require('./templates/versions.json').versions.pnpm.slice(1)\")\" \"npm@$(node -p \"require('./templates/versions.json').versions.npm.slice(1)\")\" && pnpm install --frozen-lockfile",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
